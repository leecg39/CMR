{
  "name": "korean-cmp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx apps/api/server.ts",
    "worker": "tsx apps/worker/main.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "poc": "node --import tsx scripts/poc.ts",
    "poc:recovery": "node --import tsx scripts/poc.ts --recovery",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
