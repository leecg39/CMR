# 로컬에서는 npm run setup으로 무작위 비밀값과 비소유자 DB 역할을 생성합니다.
DATABASE_URL=postgresql://cmp_app:CHANGE_ME@127.0.0.1:5432/korean_cmp
CMP_MASTER_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=http://127.0.0.1:4310
PORT=4310
DEMO_MODE=false
REQUIRE_MFA=false
# 계정 1개를 하나의 테넌트에만 연결합니다. 실발송은 별도 검증 후 활성화합니다.
SOLAPI_TENANT_ID=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_LIVE_ENABLED=false
PROVIDER_BRIDGE_SECRET=
# 격리 스캐너 컨테이너를 준비한 경우에만 설정합니다.
SCAN_RUNNER_URL=http://127.0.0.1:4321
SCAN_RUNNER_TOKEN=
